    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Mayordomo.Tools</PackageId>
    <Version>1.0.4</Version>
    <Authors>Robert Mayordomo</Authors>
    <Description>channels in .NET.</Description>
    <PackageTags>dotnet channels Helpers</PackageTags>
